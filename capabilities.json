{
  "strikethroo-progress": {
    "hooks": [
      "session.start",
      "tool.call",
      "command.run",
      "ui.render"
    ],
    "calls": [
      "$.clock.every",
      "$.command.register",
      "$.fs.exists",
      "$.fs.list",
      "$.fs.read",
      "$.session.cwd",
      "$.ui.invalidate",
      "$.ui.log",
      "$.ui.open",
      "$.ui.resolve"
    ]
  },
  "strikethroo-viewer": {
    "hooks": [
      "session.start",
      "command.run",
      "ui.render"
    ],
    "calls": [
      "$.clock.sleep",
      "$.command.register",
      "$.fs.exists",
      "$.fs.list",
      "$.fs.read",
      "$.http.fetch",
      "$.process.spawn",
      "$.session.cwd",
      "$.ui.invalidate",
      "$.ui.log",
      "$.ui.resolve",
      "$.ui.toast"
    ]
  }
}
