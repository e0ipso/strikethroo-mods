{
  "strikethroo-progress": {
    "hooks": [
      "session.start",
      "tool.call",
      "command.run",
      "ui.render"
    ],
    "calls": [
      "$.clock.every",
      "$.command.register",
      "$.fs.exists",
      "$.fs.list",
      "$.fs.read",
      "$.session.cwd",
      "$.ui.invalidate",
      "$.ui.log",
      "$.ui.open",
      "$.ui.resolve"
    ]
  },
  "strikethroo-review-findings": {
    "hooks": [
      "session.start",
      "tool.call",
      "command.run",
      "ui.render"
    ],
    "calls": [
      "$.clock.every",
      "$.command.register",
      "$.fs.exists",
      "$.fs.list",
      "$.fs.read",
      "$.prompt.fill",
      "$.session.cwd",
      "$.ui.copy",
      "$.ui.invalidate",
      "$.ui.log",
      "$.ui.open",
      "$.ui.resolve",
      "$.ui.toast"
    ]
  },
  "strikethroo-scope-watch": {
    "hooks": [
      "session.start",
      "tool.call"
    ],
    "calls": [
      "$.fs.exists",
      "$.fs.list",
      "$.fs.read",
      "$.session.cwd",
      "$.ui.log",
      "$.ui.toast"
    ]
  }
}
